#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
# Clients bundled with the AppImage (FreeRDP, TigerVNC, sshpass); RC Manager prefers them
# when they run on this system. They find their libraries via RPATH, so no LD_LIBRARY_PATH.
RC_MANAGER_BUNDLE_DIR="$HERE/usr/bin"
export RC_MANAGER_BUNDLE_DIR
exec "$HERE/usr/bin/rc-manager" "$@"
